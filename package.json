{
  "name": "setup-devai",
  "version": "0.1.0",
  "description": "npx CLI that bootstraps an OpenCode project's commands, agents, and skills from a Git-hosted registry.",
  "license": "MIT",
  "bin": {
    "setup-devai": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:unit": "tsx --test 'tests/unit/**/*.test.ts'",
    "test:integration": "tsx --test 'tests/integration/**/*.test.ts'",
    "simulatePublish": "pnpm pack --pack-destination ~/.cache/setup-devai",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "@clack/core": "1.4.1",
    "@clack/prompts": "1.5.1"
  },
  "devDependencies": {
    "@types/node": "24.13.0",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
